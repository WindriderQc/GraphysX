//
// Menu
//

IDR_MYMENU MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit",                       ID_FILE_EXIT
    END
    POPUP "&Stuff"
    BEGIN
        MENUITEM "Set Atmel Alarms",            ID_STUFF_SETALARMS
        MENUITEM "Set Atmel Time",              ID_STUFF_SETATMELTIME
        MENUITEM "Select COM Port",             ID_STUFF_SELECTCOMPORT
        MENUITEM "Select Players",              ID_STUFF_SELECTPLAYER1
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About",                      ID_HELP_ABOUT
    END
END


