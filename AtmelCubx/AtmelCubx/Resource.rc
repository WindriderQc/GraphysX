IDD_ABOUT DIALOGEX 0, 0, 248, 87
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About this program..."
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "&OK",IDOK,174,18,50,14
    GROUPBOX        "About this program...",-1,7,7,225,66
    CTEXT           "An example program using TV3D and controlling the Atmel Card with serial Comm\r\n\r\nby KamiGazz\r\n\rDubCrew 2007",
                    -1,16,18,144,49
END

IDD_DIALOG_SETLIGHTTIME DIALOGEX 0, 0, 178, 74
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | 
    WS_SYSMENU
CAPTION "Light Timer Setting"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "Set Alarm",IDOK,121,7,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,121,24,50,14
    LTEXT           "Start Time :",IDC_STATIC,7,7,40,12
    LTEXT           "Stop Time :",IDC_STATIC,7,26,37,9
    LTEXT           "Etat Alarm :",IDC_STATIC,6,54,38,10
    EDITTEXT        IDC_EDIT_TIMEON,50,7,34,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_TIMEOFF,50,26,35,12,ES_AUTOHSCROLL
    CONTROL         "On / Off",IDC_RADIO_ETATALARM,"Button",
                    BS_AUTORADIOBUTTON,50,55,38,8
END


